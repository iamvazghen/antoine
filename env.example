###############################################################################
# Antoine — environment configuration
#
# Copy this file to `.env` and fill in the values you have. Everything below the
# "OPTIONAL / ROADMAP INTEGRATIONS" banner is commented out: uncomment and set a
# key only for the providers you want to use. Items marked [ACTIVE] are already
# wired into Antoine today; items marked [ROADMAP] are placeholders for upcoming
# connectors so you can collect the keys ahead of time.
###############################################################################

# =============================================================================
# LLM PROVIDERS
# =============================================================================
# Antoine defaults to FreeLLMAPI auto-routing (no per-provider key needed) as
# long as the local proxy is running. Set any of the keys below to switch
# providers from the in-app /model menu.

# FreeLLMAPI — local OpenAI-compatible proxy. [ACTIVE, DEFAULT]
# The proxy ignores the model id and auto-routes to a free model.
FREELLMAPI_API_KEY=your-freellmapi-api-key
FREELLMAPI_BASE_URL=http://localhost:3001/v1

# Hosted LLM providers (optional — pick whichever you have). [ACTIVE]
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
MOONSHOT_API_KEY=your-moonshot-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key

# Ollama (Local LLM). [ACTIVE]
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Persistent memory embeddings (semantic search). FreeLLMAPI is chat-only and
# CANNOT produce embeddings, so memory uses a separate embedder:
#   - Ollama (local, keyless, recommended): `ollama pull nomic-embed-text`, then
#     pin it in .antoine/settings.json -> {"memory":{"embeddingProvider":"ollama"}}
#   - or a hosted key: OPENAI_API_KEY (text-embedding-3-small) / GOOGLE_API_KEY (Gemini)
# With no embedder available, memory still works in keyword-only mode.
# 'auto' priority: OpenAI -> Gemini -> Ollama.

# =============================================================================
# MARKET DATA (ACTIVE)
# =============================================================================
# Financial Datasets — equities fundamentals, prices, filings, insider trades.
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# Foreign-exchange rates (Frankfurter / ECB) and macro indicators (World Bank)
# are wired in and require NO API key.

# =============================================================================
# WEB SEARCH (ACTIVE — fallback chain: Exa -> Perplexity -> Tavily -> LangSearch)
# =============================================================================
EXASEARCH_API_KEY=your-exa-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key
TAVILY_API_KEY=your-tavily-api-key
LANGSEARCH_API_KEY=your-langsearch-api-key

# =============================================================================
# MESSAGING & SOCIAL (ACTIVE)
# =============================================================================
# X/Twitter — enables the x_search tool for public-sentiment research.
# How to get a bearer token:
#   1. Apply for a developer account at https://developer.x.com (Free tier works).
#   2. In the Developer Portal, create a Project + App.
#   3. Open the App -> "Keys and tokens" -> under "Authentication Tokens"
#      click "Generate" next to "Bearer Token" and copy it here.
X_BEARER_TOKEN=your-X-bearer-token

# Telegram bot — chat with Antoine over Telegram. Create a bot via @BotFather,
# then run `antoine telegram` (or `bun run gateway:telegram`) to finish setup.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# =============================================================================
# OBSERVABILITY (ACTIVE)
# =============================================================================
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=antoine
LANGSMITH_TRACING=false


###############################################################################
# OPTIONAL / ROADMAP INTEGRATIONS
# Uncomment and set keys for any of these to expand Antoine's market coverage.
# (These are placeholders for upcoming connectors — collecting the keys now
#  means the data is ready the moment the connector ships.)
###############################################################################

# ---- Equities / multi-asset market data [ROADMAP] ---------------------------
# Alpha Vantage — stocks, FX, crypto, technical indicators. Free: https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY=
# Polygon.io — US stocks, options, FX, crypto (real-time + historical). https://polygon.io
# POLYGON_API_KEY=
# Finnhub — real-time quotes, fundamentals, company news. https://finnhub.io
# FINNHUB_API_KEY=
# Financial Modeling Prep — fundamentals, ratios, valuations. https://site.financialmodelingprep.com
# FMP_API_KEY=
# Twelve Data — global equities, FX, crypto, indices. https://twelvedata.com
# TWELVE_DATA_API_KEY=
# Tiingo — EOD prices, news, fundamentals. https://www.tiingo.com
# TIINGO_API_KEY=
# EOD Historical Data — global exchanges incl. EU & China. https://eodhd.com
# EODHD_API_KEY=
# Nasdaq Data Link (Quandl) — economic & alternative datasets. https://data.nasdaq.com
# NASDAQ_DATA_LINK_API_KEY=

# ---- Crypto markets [ROADMAP] ----------------------------------------------
# CoinGecko (Demo plan) — prices, global market cap, dominance. https://www.coingecko.com/en/api
# COINGECKO_API_KEY=
# CoinMarketCap — listings, quotes, global metrics. https://coinmarketcap.com/api
# COINMARKETCAP_API_KEY=
# CryptoCompare — multi-exchange prices & social data. https://min-api.cryptocompare.com
# CRYPTOCOMPARE_API_KEY=
# Messari — crypto fundamentals & research. https://messari.io/api
# MESSARI_API_KEY=
# (Binance and Coinbase public market-data endpoints need no key.)

# ---- Central-bank & macro rates: US / EU / China / global [ROADMAP] --------
# FRED — US Federal Reserve: Fed funds, Treasury yields, CPI. Free: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=
# Trading Economics — global central-bank rates incl. ECB, Fed, PBoC (China). https://tradingeconomics.com/api
# TRADING_ECONOMICS_API_KEY=
# (ECB Statistical Data Warehouse, World Bank and OECD are keyless.)

# ---- Real estate [ROADMAP] -------------------------------------------------
# ATTOM Data — US property data, AVM, sales history. https://api.developer.attomdata.com
# ATTOM_API_KEY=
# RentCast — US rent estimates & property valuations. https://www.rentcast.io
# RENTCAST_API_KEY=
# Estated — US property records. https://estated.com
# ESTATED_API_KEY=
# ImmoScout24 (Germany/EU) — OAuth 1.0a consumer key/secret. https://api.immobilienscout24.de
# IS24_CLIENT_KEY=
# IS24_CLIENT_SECRET=
# RapidAPI — gateway for Zillow / Realtor / Idealista (EU) listings. https://rapidapi.com
# RAPIDAPI_KEY=

# ---- News & sentiment [ROADMAP] --------------------------------------------
# NewsAPI — headlines across thousands of sources. https://newsapi.org
# NEWSAPI_KEY=
# Marketaux — financial news with entity sentiment. https://www.marketaux.com
# MARKETAUX_API_KEY=
# Benzinga — market-moving news & ratings. https://www.benzinga.com/apis
# BENZINGA_API_KEY=
