#!/usr/bin/env bash
# POSIX twin of antoine.cmd, for Git Bash / WSL / MSYS.
#
# PowerShell and cmd resolve a bare `antoine` to antoine.cmd through PATHEXT.
# Bash has no such mechanism and only runs an exact filename match, so without
# this file `antoine` is "command not found" in Git Bash even though the shim
# is right there on PATH.
set -euo pipefail

: "${ANTOINE_REPO:=/c/Users/iamva/dexter}"
: "${ANTOINE_VPS:=openclaw@100.107.141.83}"

if [ ! -f "$ANTOINE_REPO/package.json" ]; then
  echo "[antoine] No checkout at $ANTOINE_REPO" >&2
  echo "[antoine] Set ANTOINE_REPO to the repository path and try again." >&2
  exit 1
fi

# Pin state to the checkout so memory, portfolio, scores and cron jobs are the
# same set regardless of the directory this was launched from.
: "${ANTOINE_HOME:=$ANTOINE_REPO/.antoine}"
export ANTOINE_HOME

cd "$ANTOINE_REPO"

case "${1:-}" in
  gateway)
    # Telegram + scheduled reviews. The VPS owns this in normal operation;
    # running it here too would make two processes poll the same bot token.
    shift
    exec bun run gateway "$@"
    ;;
  health)
    exec bun run health
    ;;
  test)
    exec bun test
    ;;
  pull)
    # The VPS is authoritative: Telegram conversations and the scheduled
    # reviews all write there.
    echo "[antoine] pulling memory + scores from $ANTOINE_VPS"
    scp -q "$ANTOINE_VPS:~/.antoine/memory/MEMORY.md" "$ANTOINE_HOME/memory/MEMORY.md"
    scp -qr "$ANTOINE_VPS:~/.antoine/scores" "$ANTOINE_HOME/"
    echo "[antoine] done"
    ;;
  push)
    echo "[antoine] pushing local memory to $ANTOINE_VPS"
    scp -q "$ANTOINE_HOME/memory/MEMORY.md" "$ANTOINE_VPS:~/.antoine/memory/MEMORY.md"
    echo "[antoine] done - restart the gateway there if it should pick it up now"
    ;;
  vps)
    ssh "$ANTOINE_VPS" "systemctl --user ${2:-status} antoine-gateway; systemctl --user is-active antoine-gateway"
    ;;
  logs)
    ssh "$ANTOINE_VPS" 'tail -n 40 ~/.antoine/gateway.log'
    ;;
  *)
    # The interactive TUI needs a real terminal. Refuse clearly rather than
    # hanging forever on a pipe, which is what happens otherwise.
    if [ ! -t 0 ] || [ ! -t 1 ]; then
      echo "[antoine] The interactive UI needs a terminal (stdin/stdout are not a TTY here)." >&2
      echo "[antoine] Run it from Windows Terminal, PowerShell or a real shell." >&2
      echo "[antoine] Non-interactive subcommands that do work: health, test, pull, push, vps, logs" >&2
      exit 1
    fi
    exec bun run src/index.tsx "$@"
    ;;
esac
